# Optional env file for compose stacks (copy to .env in repo root)
# docker compose automatically loads ./.env

# local | production — controls Secure cookies (production = Secure)
NODE_ENV=local
JWT_SECRET=change-me-to-a-long-random-string
ONLYOFFICE_JWT_SECRET=blckbox-onlyoffice-jwt-secret-change-me
POSTGRES_PASSWORD=blckbox
CERTBOT_EMAIL=admin@blckbox.dms.com
