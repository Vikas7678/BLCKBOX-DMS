# PostgreSQL
# Example with a local Postgres container on port 5433:
#   docker run -d --name blckbox-postgres -e POSTGRES_USER=blckbox -e POSTGRES_PASSWORD=blckbox -e POSTGRES_DB=blckbox -p 5433:5432 postgres:16-alpine
DATABASE_URL=postgresql://blckbox:blckbox@localhost:5433/blckbox

# Auth
JWT_SECRET=dev-secret-change-me
JWT_COOKIE_NAME=blckbox_token
JWT_EXPIRES_DAYS=7

# Server
# local = HTTP cookies (docker local / npm run dev); production = Secure cookies (HTTPS)
NODE_ENV=local
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Local file storage (swappable later for S3/MinIO)
STORAGE_PATH=./data/uploads
MAX_UPLOAD_BYTES=26214400

# OnlyOffice Document Server (see docker-compose-only-office/)
# PUBLIC_API_URL must be reachable FROM the OnlyOffice container (include /api prefix)
PUBLIC_API_URL=http://host.docker.internal:4000/api
# Browser-facing API (image preview <img src>)
BROWSER_API_URL=http://localhost:4000/api
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=blckbox-onlyoffice-jwt-secret-change-me

# Redis (BullMQ trash purge queue)
# Example:
#   docker run -d --name blckbox-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://127.0.0.1:6379
